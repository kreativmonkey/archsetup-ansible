{{ ansible_managed | comment }}
[Interface]
Address = {{ wireguard_interface.address }}
PrivateKey = {{ __wireguard_private_key }}
{% if wireguard_interface.listen_port is defined %}
ListenPort = {{ wireguard_interface.listen_port }}
{% endif %}
{% if wireguard_interface.mtu is defined %}
MTU = {{ wireguard_interface.mtu }}
{% endif %}
{% if wireguard_interface.dns is defined %}
DNS = {{ wireguard_interface.dns }}
{% endif %}
{#
  DNS = above tells wg-quick which resolver to use. It does not make
  systemd-resolved route a domain to it, so a split-DNS zone needs the routing
  domain set explicitly — that is what the ~ prefix does.

  resolvectl rejects a domain that starts with a dot, and a search domain is
  just as often written `.example.org` as `example.org`. Both spellings, and an
  already prefixed `~example.org`, have to end up as the same routing domain —
  a rejected one fails the PostUp and wg-quick then tears the whole tunnel down
  again.
#}
{% set routing_domains = wireguard_interface.search_domains | default([])
     | map('trim') | map('regex_replace', '^[~.]+', '')
     | map('regex_replace', '[.]+$', '') | select | list %}
{% if routing_domains | length > 0 %}
PostUp = resolvectl dns %i {{ wireguard_interface.dns }}; resolvectl domain %i {{ routing_domains | map('regex_replace', '^', '~') | join(' ') }}
PostDown = resolvectl revert %i
{% endif %}
{% for post_up in wireguard_interface.post_up | default([]) %}
PostUp = {{ post_up }}
{% endfor %}
{% for post_down in wireguard_interface.post_down | default([]) %}
PostDown = {{ post_down }}
{% endfor %}
{% for peer in wireguard_interface.peers | default([]) %}

[Peer]
PublicKey = {{ peer.public_key }}
{% if peer.preshared_key is defined %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
AllowedIPs = {{ peer.allowed_ips }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}
{% endfor %}
