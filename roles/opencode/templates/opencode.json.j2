{
  "$schema": "https://opencode.ai/config.json",
  "provider": {{ opencode_providers | combine(opencode_providers_extra) | to_json(indent=2) }},
  "model": "{{ opencode_model }}",
  "small_model": "{{ opencode_small_model }}",
  "agent": {{ opencode_agents | combine({'orchestration': opencode_orchestration}) | to_json(indent=2) }},
  "permission": {{ opencode_permissions | to_json(indent=2) }},
  "plugin": {{ opencode_plugins | to_json }},
  "lsp": {{ opencode_lsp | to_json(indent=2) }},
  "mcp": {{ opencode_mcp | combine(opencode_mcp_extra) | to_json(indent=2) }}
}
